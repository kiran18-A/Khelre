<%- include('layout/header') %>

<style>
/* BADMINTON DIGITAL SCOREBOARD STYLES */
body {
    background: #0f172a !important;
    color: white !important;
    overflow-x: hidden;
}

.scoreboard-container {
    max-width: 1000px;
    margin: 2rem auto;
    padding: 0 1rem;
}

.sb-header {
    text-align: center;
    margin-bottom: 2rem;
}

.sb-sport-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(0, 102, 204, 0.2);
    color: #4da6ff;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    border: 1px solid rgba(0, 102, 204, 0.4);
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1rem;
}

.sb-title {
    font-size: 2.5rem;
    font-weight: 900;
    margin: 0;
    background: linear-gradient(135deg, #fff, #b9d9ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.sb-host {
    color: #94a3b8;
    margin-top: 0.5rem;
    font-size: 1.1rem;
}

.digital-board {
    background: linear-gradient(180deg, #1e293b, #0f172a);
    border: 2px solid #334155;
    border-radius: 24px;
    padding: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), inset 0 2px 10px rgba(255,255,255,0.05);
    position: relative;
    overflow: hidden;
}

.digital-board::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.1) 2px, rgba(0,0,0,0.1) 4px);
    pointer-events: none;
}

.team-score {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
}

.team-name {
    font-size: 2rem;
    font-weight: 800;
    color: #e2e8f0;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.score-box {
    background: #000;
    border: 4px solid #1e293b;
    border-radius: 16px;
    padding: 1rem 2rem;
    min-width: 200px;
    text-align: center;
    box-shadow: inset 0 0 20px rgba(0, 102, 204, 0.2);
}

.score-digit {
    font-family: monospace;
    font-size: 8rem;
    font-weight: bold;
    color: #00d4ff;
    line-height: 1;
    text-shadow: 0 0 20px rgba(0, 212, 255, 0.6);
}

.vs-badge {
    background: #334155;
    color: #94a3b8;
    padding: 1rem;
    border-radius: 50%;
    font-weight: 900;
    font-size: 1.5rem;
    z-index: 2;
    border: 4px solid #0f172a;
}

.score-controls {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
}

.btn-ctrl {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: none;
    font-size: 2rem;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
}

.btn-ctrl:hover {
    transform: scale(1.1);
}

.btn-minus {
    background: #334155;
    color: #e2e8f0;
}
.btn-minus:hover { background: #475569; }

.btn-plus {
    background: #0066cc;
    color: white;
    box-shadow: 0 0 15px rgba(0,102,204,0.5);
}
.btn-plus:hover { background: #0077ee; }

.actions-row {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
}

.btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    background: rgba(255,255,255,0.1);
    color: white;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s;
}
.btn-back:hover {
    background: rgba(255,255,255,0.2);
    color: white;
    text-decoration: none;
}

.btn-save {
    padding: 1rem 3rem;
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    border: none;
    border-radius: 50px;
    font-weight: 800;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
}
.btn-save:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.6);
}

/* Responsive Mobile Styles */
@media (max-width: 768px) {
    .sb-title {
        font-size: 1.8rem;
    }
    .digital-board {
        padding: 1.5rem 0.5rem;
        gap: 0.5rem;
    }
    .team-name {
        font-size: 1.2rem;
    }
    .team-name div {
        font-size: 1rem !important; /* Scale down player names */
    }
    .score-box {
        min-width: 100px;
        padding: 0.5rem;
    }
    .score-digit {
        font-size: 4rem;
    }
    .vs-badge {
        padding: 0.5rem;
        font-size: 1rem;
        border-width: 2px;
        min-width: 40px;
        text-align: center;
    }
    .score-controls {
        gap: 0.5rem;
    }
    .btn-ctrl {
        width: 45px;
        height: 45px;
        font-size: 1.5rem;
    }
    .actions-row {
        flex-direction: column;
    }
}
</style>

<div class="scoreboard-container">
    <div class="sb-header">
        <div class="sb-sport-tag">🏸 &nbsp;Badminton Live Scorecard</div>
        <h1 class="sb-title"><%= match.team_name %></h1>
        <div class="sb-host">Hosted by <%= hostName %></div>
    </div>

    <% 
        let scoreA = 0, scoreB = 0;
        if (match.score) {
            const parts = match.score.split('-');
            if (parts.length === 2) {
                scoreA = parseInt(parts[0].trim()) || 0;
                scoreB = parseInt(parts[1].trim()) || 0;
            }
        }
    %>

    <form action="/sport/badminton/score/<%= match.id %>?redirect=scorecard" method="POST" id="scoreForm">
        <div class="digital-board">
            <!-- Team A -->
            <div class="team-score">
                <div class="team-name">
                    <% teamAPlayers.forEach((p, i) => { %>
                        <div style="font-size: 1.2rem; margin-bottom: 0.2rem; font-weight: 700; color: #cbd5e1;"><%= p %></div>
                        <% if (i < teamAPlayers.length - 1) { %><span style="font-size: 0.8rem; color: #475569;">&</span><% } %>
                    <% }); %>
                    <% if (teamAPlayers.length === 1) { %>
                        <div style="font-size: 0.9rem; color: #475569; font-weight: normal; margin-top: 5px;">(Awaiting Partner)</div>
                    <% } %>
                </div>
                <div class="score-box">
                    <div class="score-digit" id="displayA"><%= scoreA %></div>
                </div>
                <% if (canEditScore && match.status === 'started') { %>
                <div class="score-controls">
                    <button type="button" class="btn-ctrl btn-minus" onclick="changeScore('A', -1)">-</button>
                    <button type="button" class="btn-ctrl btn-plus" onclick="changeScore('A', 1)">+</button>
                </div>
                <% } %>
            </div>

            <div class="vs-badge">VS</div>

            <!-- Team B -->
            <div class="team-score">
                <div class="team-name">
                    <% if (teamBPlayers.length === 0) { %>
                        <div style="font-size: 1.2rem; color: #475569; font-style: italic;">Awaiting Opponents...</div>
                    <% } else { %>
                        <% teamBPlayers.forEach((p, i) => { %>
                            <div style="font-size: 1.2rem; margin-bottom: 0.2rem; font-weight: 700; color: #cbd5e1;"><%= p %></div>
                            <% if (i < teamBPlayers.length - 1) { %><span style="font-size: 0.8rem; color: #475569;">&</span><% } %>
                        <% }); %>
                    <% } %>
                </div>
                <div class="score-box">
                    <div class="score-digit" id="displayB"><%= scoreB %></div>
                </div>
                <% if (canEditScore && match.status === 'started') { %>
                <div class="score-controls">
                    <button type="button" class="btn-ctrl btn-minus" onclick="changeScore('B', -1)">-</button>
                    <button type="button" class="btn-ctrl btn-plus" onclick="changeScore('B', 1)">+</button>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Hidden input to submit the actual combined score string -->
        <input type="hidden" name="score" id="scoreInput" value="<%= scoreA %> - <%= scoreB %>">
        <input type="hidden" name="scoreDelta" id="scoreDeltaInput" value="0,0">

        <div class="actions-row">
            <a href="/sport/badminton" class="btn-back">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Back to Matches
            </a>
            <% if (canEditScore && match.status === 'started') { %>
                <button type="submit" class="btn-save" style="margin-right: 10px;">💾 Save Score</button>
                <% if (typeof user !== 'undefined' && user && match.user_id.toString() === user.id.toString()) { %>
                <button type="button" class="btn-save" style="background: linear-gradient(135deg, #dc2626, #991b1b); box-shadow: 0 4px 15px rgba(220, 38, 38, 0.4);" onclick="finishBadmintonMatch()">🏁 Finish & Save Score</button>
                <% } %>
            <% } %>
        </div>
    </form>
</div>

<script>
    let currentA = <%= scoreA %>;
    let currentB = <%= scoreB %>;
    let deltaA = 0;
    let deltaB = 0;

    function changeScore(team, amount) {
        if (team === 'A') {
            let nextA = Math.max(0, currentA + amount);
            deltaA += (nextA - currentA);
            currentA = nextA;
            document.getElementById('displayA').innerText = currentA;
        } else {
            let nextB = Math.max(0, currentB + amount);
            deltaB += (nextB - currentB);
            currentB = nextB;
            document.getElementById('displayB').innerText = currentB;
        }
        
        // Update hidden input format: "A - B"
        document.getElementById('scoreInput').value = `${currentA} - ${currentB}`;
        document.getElementById('scoreDeltaInput').value = `${deltaA},${deltaB}`;
    }

    function finishBadmintonMatch() {
        if (!confirm('Are you sure you want to finish this match? The final score will be saved to all players\' records.')) return;

        // Submit a single form with the current score to the player-stats route
        const f = document.createElement('form');
        f.method = 'POST';
        f.action = '/sport/badminton/player-stats/<%= match.id %>';

        const addField = (name, value) => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            f.appendChild(input);
        };

        addField('scoreA', currentA);
        addField('scoreB', currentB);

        document.body.appendChild(f);
        f.submit();
    }
</script>

<% if (isFinished) { 
    let winnerText = 'Match Finished!';
    if (scoreA > scoreB) winnerText = '🏆 Team A Won 🏆';
    else if (scoreB > scoreA) winnerText = '🏆 Team B Won 🏆';
    else winnerText = '🤝 Match Drawn 🤝';
%>
<div id="matchFinishedModal" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); display:flex; justify-content:center; align-items:center; z-index:9999;">
    <div style="text-align: center; padding: 3rem 2rem; background: linear-gradient(135deg, #ffffff, #f0fdf4); border: 2px solid #22c55e; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); width: 90%; max-width: 500px;">
        <div style="font-size: 4rem; margin-bottom: 1rem;">🎉</div>
        <h2 style="font-size: 2.2rem; font-weight: 900; color: #16a34a; margin-bottom: 0.5rem;">Match Played!</h2>
        <div style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-bottom: 1.5rem;"><%= match.team_name %></div>
        
        <div style="background: white; border: 2px solid #bbf7d0; border-radius: 20px; padding: 2rem 1.5rem; margin-bottom: 2.5rem; box-shadow: 0 10px 30px rgba(34, 197, 94, 0.15);">
            <div style="font-size: 1rem; font-weight: 800; color: #64748b; margin-bottom: 0.8rem; text-transform: uppercase; letter-spacing: 2px;">Final Score</div>
            <div style="font-size: 4rem; font-weight: 900; color: #15803d; line-height: 1;"><%= scoreA %> - <%= scoreB %></div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #dc2626; margin-top: 1.5rem;"><%= winnerText %></div>
        </div>

        <button onclick="document.getElementById('matchFinishedModal').style.display='none'" style="background: linear-gradient(135deg, #16a34a, #15803d); color: white; border: none; padding: 1.2rem 3.5rem; font-size: 1.15rem; font-weight: 800; border-radius: 50px; cursor: pointer; box-shadow: 0 6px 20px rgba(22, 163, 74, 0.4); transition: transform 0.2s;">
            Awesome!
        </button>
    </div>
</div>
<% } %>

<%- include('layout/footer') %>
