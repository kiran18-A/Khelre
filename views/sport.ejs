        </div>

        <form action="/sport/<%= sportName.toLowerCase() %>/new" method="POST" class="ng-form">
            <div class="ng-section">
                <div class="ng-section-label"><span class="ng-section-icon">🛡️</span><span>Team Name</span></div>
