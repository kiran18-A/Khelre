<script>
    let map = null;
    let marker = null;

    function initMap() {
        if (!map) {
            map = L.map('mapPicker').setView([19.8762, 75.3433], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom:19, attribution:'© OpenStreetMap' }).addTo(map);
            L.Control.geocoder({
                defaultMarkGeocode: false,
                geocoder: L.Control.Geocoder.nominatim({ geocodingQueryParams: { viewbox:"75.2000,19.9500,75.4500,19.7500", bounded:1 } })
            }).on('markgeocode', function(e) {
                const latlng = e.geocode.center;
                map.setView(latlng, 15);
                if (marker) marker.setLatLng(latlng); else marker = L.marker(latlng).addTo(map);
                document.getElementById('googleMapsLink').value = `https://www.google.com/maps?q=${latlng.lat},${latlng.lng}`;
                const locInput = document.querySelector('input[name="location"]');
                if (locInput && !locInput.value) locInput.value = e.geocode.name;
            }).addTo(map);
            map.on('click', function(e) {
                if (marker) marker.setLatLng(e.latlng); else marker = L.marker(e.latlng).addTo(map);
                document.getElementById('googleMapsLink').value = `https://www.google.com/maps?q=${e.latlng.lat},${e.latlng.lng}`;
            });
        } else { map.invalidateSize(); }
    }

    function getLiveLocation() {
        if (!navigator.geolocation) { alert("Geolocation not supported."); return; }
        navigator.geolocation.getCurrentPosition(function(pos) {
            const lat = pos.coords.latitude, lng = pos.coords.longitude;
            map.setView([lat, lng], 15);
            if (marker) marker.setLatLng([lat, lng]); else marker = L.marker([lat, lng]).addTo(map);
            document.getElementById('googleMapsLink').value = `https://www.google.com/maps?q=${lat},${lng}`;
            const locInput = document.querySelector('input[name="location"]');
            if (locInput && !locInput.value) locInput.value = "My Current Location";
        }, function() { alert("Could not get location. Allow location access."); }, { enableHighAccuracy:true, timeout:10000 });
    }

    function searchAddress() {
        const query = document.getElementById('locationSearchInput').value.trim();
        if (!query) { alert("Please enter a location."); return; }
        const btn = document.getElementById('searchBtn');
        btn.textContent = 'Searching…'; btn.disabled = true;
        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&viewbox=75.2000,19.9500,75.4500,19.7500&bounded=1&limit=1&accept-language=en`, { headers:{'Accept':'application/json'} })
            .then(r => r.json())
            .then(data => {
                btn.textContent = 'Search'; btn.disabled = false;
                if (data && data.length > 0) {
                    const lat = parseFloat(data[0].lat), lng = parseFloat(data[0].lon);
                    map.setView([lat, lng], 15);
                    if (marker) marker.setLatLng([lat, lng]); else marker = L.marker([lat, lng]).addTo(map);
                    document.getElementById('googleMapsLink').value = `https://www.google.com/maps?q=${lat},${lng}`;
                    document.getElementById('locationSearchInput').value = data[0].name || data[0].display_name.split(',')[0];
                } else { alert("Location not found. Try a different keyword."); }
            })
            .catch(() => { btn.textContent = 'Search'; btn.disabled = false; alert("Search failed."); });
    }

    let suggestionTimeout = null;
    document.addEventListener('DOMContentLoaded', () => {
        const locInput = document.getElementById('locationSearchInput');
        const suggBox = document.getElementById('locationSuggestions');

        if (locInput) {
            locInput.addEventListener('focus', function() {
                if (this.value.trim() !== '') return;
                
                let coachHtml = '';
                if ('<%= sportName.toLowerCase() %>' === 'badminton') {
                    coachHtml = `<div class="suggestion-item" onclick="
                        document.getElementById('locationSearchInput').value = 'Badminton Coach Session';
                        document.getElementById('locationSuggestions').style.display = 'none';
                        document.getElementById('googleMapsLink').value = '';
                    ">🏸 <strong>Book a Badminton Coach</strong> <span style="font-size:0.8em; color:#64748b;">Professional Training</span></div>`;
                }

                if (!navigator.geolocation) {
                    if (coachHtml) {
                        suggBox.innerHTML = coachHtml;
                        suggBox.style.display = 'block';
                    }
                    return;
                }

                suggBox.innerHTML = coachHtml + '<div class="suggestion-item">📍 Finding nearby grounds (3km)...</div>';
                suggBox.style.display = 'block';

                navigator.geolocation.getCurrentPosition(pos => {
                    if (this.value.trim() !== '') return;
                    const lat = pos.coords.latitude;
                    const lon = pos.coords.longitude;
                    const query = `
                        [out:json][timeout:10];
                        (
                          node["leisure"~"pitch|stadium|park|sports_centre"](around:3000,${lat},${lon});
                          way["leisure"~"pitch|stadium|park|sports_centre"](around:3000,${lat},${lon});
                        );
                        out center;
                    `;
                    fetch('https://overpass-api.de/api/interpreter', {
                        method: 'POST',
                        body: query
                    }).then(r => r.json()).then(data => {
                        if (this.value.trim() !== '') return;
                        suggBox.innerHTML = '';
                        let count = 0;

                        if ('<%= sportName.toLowerCase() %>' === 'badminton') {
                            const div = document.createElement('div');
                            div.className = 'suggestion-item';
                            div.innerHTML = '🏸 <strong>Book a Badminton Coach</strong> <span style="font-size:0.8em; color:#64748b;">Professional Training</span>';
                            div.onclick = function() {
                                locInput.value = 'Badminton Coach Session';
                                suggBox.style.display = 'none';
                                document.getElementById('googleMapsLink').value = '';
                            };
                            suggBox.appendChild(div);
                            count++;
                        }
                        if (data.elements && data.elements.length > 0) {
                            data.elements.forEach(el => {
                                if (count >= 10) return;
                                const name = el.tags && el.tags.name;
                                if (!name) return;
                                count++;
                                const div = document.createElement('div');
                                div.className = 'suggestion-item';
                                div.innerHTML = `📍 <strong>${name}</strong>`;
                                div.onclick = function() {
                                    locInput.value = name;
                                    suggBox.style.display = 'none';
                                    const elLat = el.lat || el.center.lat;
                                    const elLon = el.lon || el.center.lon;
                                    map.setView([elLat, elLon], 15);
                                    if (marker) marker.setLatLng([elLat, elLon]); else marker = L.marker([elLat, elLon]).addTo(map);
                                    document.getElementById('googleMapsLink').value = `https://www.google.com/maps?q=${elLat},${elLon}`;
                                };
                                suggBox.appendChild(div);
                            });
                        }
                        if (count === 0) {
                            suggBox.innerHTML = '<div class="suggestion-item" style="color:#64748b;">No named grounds found within 3km. Type to search globally.</div>';
                        }
                        if (count > 0) suggBox.style.display = 'block';
                    }).catch(() => {
                        if (this.value.trim() === '') suggBox.style.display = 'none';
                    });
                }, err => {
                    if (this.value.trim() === '') suggBox.style.display = 'none';
                });
            });

            locInput.addEventListener('input', function() {
                clearTimeout(suggestionTimeout);
                const query = this.value.trim();
                if (query.length < 3) { suggBox.style.display = 'none'; return; }
                
                suggestionTimeout = setTimeout(() => {
                    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&viewbox=75.2000,19.9500,75.4500,19.7500&bounded=1&limit=5&accept-language=en`, { headers:{'Accept':'application/json'} })
                    .then(r => r.json())
                    .then(data => {
                        suggBox.innerHTML = '';
                        let addedCoach = false;
                        if ('<%= sportName.toLowerCase() %>' === 'badminton' && query.toLowerCase().includes('coach')) {
                            const div = document.createElement('div');
                            div.className = 'suggestion-item';
                            div.innerHTML = '🏸 <strong>Book a Badminton Coach</strong> <span style="font-size:0.8em; color:#64748b;">Professional Training</span>';
                            div.onclick = function() {
                                locInput.value = 'Badminton Coach Session';
                                suggBox.style.display = 'none';
                                document.getElementById('googleMapsLink').value = '';
                            };
                            suggBox.appendChild(div);
                            addedCoach = true;
                        }

                        if (data && data.length > 0) {
                            data.forEach(item => {
                                const div = document.createElement('div');
                                div.className = 'suggestion-item';
                                const shortName = item.name || item.display_name.split(',')[0];
                                const subName = item.display_name.split(',').slice(1,3).join(',');
                                div.innerHTML = `📍 <strong>${shortName}</strong> <span style="font-size:0.8em; color:#64748b;">${subName}</span>`;
                                div.onclick = function() {
                                    locInput.value = shortName;
                                    suggBox.style.display = 'none';
                                    const lat = parseFloat(item.lat), lng = parseFloat(item.lon);
                                    map.setView([lat, lng], 15);
                                    if (marker) marker.setLatLng([lat, lng]); else marker = L.marker([lat, lng]).addTo(map);
                                    document.getElementById('googleMapsLink').value = `https://www.google.com/maps?q=${lat},${lng}`;
                                };
                                suggBox.appendChild(div);
                            });
                            suggBox.style.display = 'block';
                        } else if (addedCoach) {
                            suggBox.style.display = 'block';
                        } else {
                            suggBox.style.display = 'none';
                        }
                    }).catch(() => suggBox.style.display = 'none');
                }, 400);
            });
            
            document.addEventListener('click', function(e) {
                if (e.target !== locInput && e.target !== suggBox) {
                    suggBox.style.display = 'none';
                }
            });
        }
    });

    function openNewGameModal()  { document.getElementById('newGameModal').style.display = 'flex'; setTimeout(initMap, 50); }
    function closeNewGameModal() { document.getElementById('newGameModal').style.display = 'none'; }

    window.addEventListener('click', function(e) {
        if (e.target === document.getElementById('newGameModal')) closeNewGameModal();
        if (e.target === document.getElementById('matchFinishedModal')) document.getElementById('matchFinishedModal').style.display='none';
    });

    async function submitRating(starElement, matchId, rateeId, rating) {
        const container = starElement.parentElement;
        const stars = container.querySelectorAll('.star');
        stars.forEach(s => {
            if (parseInt(s.getAttribute('data-value')) <= rating) {
                s.classList.add('filled');
                s.style.color = '#f59e0b';
            } else {
                s.classList.remove('filled');
                s.style.color = '#cbd5e1';
            }
        });

        try {
            const res = await fetch(`/sport/<%= sportName.toLowerCase() %>/rate/${matchId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ratee_id: rateeId, rating: rating })
            });
            const data = await res.json();
            if (!data.success) {
                alert(data.message || 'Error submitting rating');
            }
        } catch (e) {
            console.error(e);
            alert('Error submitting rating');
        }
    }
</script>

<% if (typeof finishedMatchId !== 'undefined' && finishedMatchId) { 
    const finishedMatch = matches.find(m => m.id == finishedMatchId);
    if (finishedMatch) {
        let winnerText = 'Match Finished!';
        if (finishedMatch.score) {
            const parts = finishedMatch.score.split('-');
            if (parts.length === 2) {
                const scoreA = parseInt(parts[0].trim());
                const scoreB = parseInt(parts[1].trim());
                if (!isNaN(scoreA) && !isNaN(scoreB)) {
                    if (scoreA > scoreB) winnerText = '🏆 Team A Won 🏆';
                    else if (scoreB > scoreA) winnerText = '🏆 Team B Won 🏆';
                    else winnerText = '🤝 Match Drawn 🤝';
                }
            }
        }
%>
