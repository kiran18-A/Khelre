                        <%= sc.icon %> &nbsp;Post a Game
                    </button>
                <% } else { %>
                    <button class="btn-cricket-new" onclick="openAuthModal()" style="margin:0 auto; display:inline-flex;">
                        🔐 Login to Post
                    </button>
                <% } %>
            </div>
        <% } %>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.match-card');
    let userLocation = null;

    function calculateDistance(lat1, lon1, lat2, lon2) {
        const R = 6371; // Radius of the earth in km
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                  Math.sin(dLon/2) * Math.sin(dLon/2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        return R * c; 
    }

    filterBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const filter = e.target.getAttribute('data-filter');
            
            if (filter.startsWith('nearby')) {
                const maxDist = parseInt(filter.split('-')[1]) || 3;
                if (!navigator.geolocation) {
                    alert("Geolocation is not supported by your browser.");
                    return;
                }
                const originalText = e.target.textContent;
                e.target.textContent = '📍 Locating...';
                
                navigator.geolocation.getCurrentPosition(
                    (pos) => {
                        e.target.textContent = `📍 Near Me (${maxDist}km)`;
                        userLocation = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                        
                        filterBtns.forEach(b => b.classList.remove('active'));
                        e.target.classList.add('active');
                        
                        cards.forEach(card => {
                            const clat = parseFloat(card.getAttribute('data-lat'));
                            const clng = parseFloat(card.getAttribute('data-lng'));
                            
                            let distBadge = card.querySelector('.distance-badge');
                            
                            if (!isNaN(clat) && !isNaN(clng)) {
                                const dist = calculateDistance(userLocation.lat, userLocation.lng, clat, clng);
                                
                                if (!distBadge) {
                                    distBadge = document.createElement('div');
                                    distBadge.className = 'distance-badge';
                                    distBadge.style.fontSize = '0.75rem';
                                    distBadge.style.color = '#64748b';
                                    distBadge.style.fontWeight = 'bold';
                                    distBadge.style.marginTop = '0.5rem';
                                    card.querySelector('.match-card-info').appendChild(distBadge);
                                }
                                distBadge.innerHTML = `📍 ${dist.toFixed(1)} km away`;
                                distBadge.style.display = 'block';
                                
                                if (dist <= maxDist) {
                                    card.style.display = 'flex';
                                } else {
                                    card.style.display = 'none';
                                }
                            } else {
                                if (distBadge) distBadge.style.display = 'none';
                                card.style.display = 'none';
                            }
                        });
                    },
                    (error) => {
                        e.target.textContent = originalText;
                        alert("Location access denied or unavailable. Showing all city grounds.");
                        
                        filterBtns.forEach(b => b.classList.remove('active'));
                        const allBtn = document.querySelector('[data-filter="all"]');
                        if (allBtn) {
                            allBtn.classList.add('active');
                            cards.forEach(card => card.style.display = 'flex');
                        }
                    },
                    { enableHighAccuracy: true, timeout: 10000 }
                );
                return;
            }

            // Normal filters
            filterBtns.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            
            cards.forEach(card => {
                let distBadge = card.querySelector('.distance-badge');
                if (distBadge && !filter.startsWith('nearby')) {
                    distBadge.style.display = 'none';
                }
                
                if (filter === 'all') {
                    card.style.display = 'flex';
                } else if (filter === 'started') {
                    card.style.display = card.classList.contains('is-started') ? 'flex' : 'none';
                } else if (filter === 'open') {
                    const badge = card.querySelector('.status-badge.open');
                    card.style.display = badge ? 'flex' : 'none';
                } else if (filter === 'finished') {
                    const badgeText = card.querySelector('.status-badge')?.innerText || '';
                    card.style.display = badgeText.includes('Finished') ? 'flex' : 'none';
                }
            });
        });
    });
});
</script>

