                                    <% } %>
                                    <% teamB.forEach((p, i) => { %>
                                        <li class="player-item <%= p.id.toString() === (capB_id ? capB_id.toString() : '') ? 'host-item' : '' %>">
                                            <div class="player-avatar <%= p.id.toString() === (capB_id ? capB_id.toString() : '') ? 'host' : 'member' %>"><%= p.id.toString() === (capB_id ? capB_id.toString() : '') ? '👑' : '🏏' %></div>
                                            <div style="flex:1;">
                                                <div class="player-name">
                                                    <%= p.name %>
                                                    <% if (typeof playerAvgRatings !== 'undefined' && playerAvgRatings[p.id]) { %>
                                                        <span style="font-size: 0.8rem; color: #f59e0b; margin-left: 0.5rem; background: rgba(245,158,11,0.1); padding: 0.1rem 0.4rem; border-radius: 4px;">⭐ <%= playerAvgRatings[p.id].avg %></span>
