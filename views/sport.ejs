                                            </div>
                                            <% if (isHost && !isStarted) { %>
                                                <label style="display:flex; align-items:center; gap:0.5rem; font-size:0.8rem; cursor:pointer;">
                                                    <input type="radio" name="team_b_captain" value="<%= p.id %>" <%= p.id.toString() === (capB_id ? capB_id.toString() : '') ? 'checked' : '' %>> Cap
                                                </label>
                                                <select name="team_<%= p.id %>" style="background:#334155; color:white; border:1px solid #475569; border-radius:6px; padding:0.3rem 0.5rem; font-size:0.85rem; font-weight:bold; cursor:pointer; margin-left: 0.5rem;">
                                                    <option value="A">Team A</option>
                                                    <option value="B" selected>Team B</option>
