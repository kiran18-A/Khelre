<!-- ═══════════════════════ ANIMATION OVERLAYS ═══════════════════════ -->
<div id="cricket-animation-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:9999;display:none;">
    <canvas id="cricketCanvas" style="width:100%;height:100%;"></canvas>
</div>
<div id="badminton-animation-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:9999;display:none;">
    <canvas id="badmintonCanvas" style="width:100%;height:100%;"></canvas>
</div>

<script>
/* ── Counter animation ─────────────────────────────────── */
function animateCounters() {
    document.querySelectorAll('.stat-num[data-target]').forEach(el => {
        const target = parseInt(el.dataset.target);
        let current = 0;
        const step = Math.ceil(target / 60);
        const timer = setInterval(() => {
            current = Math.min(current + step, target);
            el.textContent = current;
            if (current >= target) clearInterval(timer);
        }, 25);
    });
}
const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { animateCounters(); observer.disconnect(); } });
}, { threshold: 0.3 });
observer.observe(document.querySelector('.hero-stats-bar'));

/* ── Hero canvas particle background ──────────────────── */
(function() {
    const canvas = document.getElementById('heroBg');
    const ctx = canvas.getContext('2d');
    let W, H, particles;

    function resize() {
        W = canvas.width  = canvas.offsetWidth;
        H = canvas.height = canvas.offsetHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    function makeParticle() {
        return {
            x: Math.random() * W,
            y: Math.random() * H,
            r: 1 + Math.random() * 2,
            vx: (Math.random() - 0.5) * 0.4,
            vy: -0.2 - Math.random() * 0.4,
            alpha: 0.2 + Math.random() * 0.4,
            color: ['#6366f1','#3b82f6','#f97316','#10b981'][Math.floor(Math.random()*4)]
        };
    }
    particles = Array.from({ length: 80 }, makeParticle);

    function loop() {
        ctx.clearRect(0, 0, W, H);
        particles.forEach(p => {
            ctx.globalAlpha = p.alpha;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
            ctx.fill();
            p.x += p.vx; p.y += p.vy;
            if (p.y < -10) { Object.assign(p, makeParticle(), { y: H + 10 }); }
        });
        ctx.globalAlpha = 1;
        requestAnimationFrame(loop);
    }
    loop();
})();

/* ── Cricket animation (original kept intact) ─────────── */
function playCricketAnimation(e, url) {
    e.preventDefault();
    const overlay = document.getElementById('cricket-animation-overlay');
    overlay.style.display = 'block';
    const canvas = document.getElementById('cricketCanvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth * 2;
    canvas.height = window.innerHeight * 2;
    ctx.scale(2, 2);
    const W = window.innerWidth;
    const H = window.innerHeight;
    let t = 0;
    const TOTAL = 180;
    const particles = [];
    const sparks = [];
    let shakeX = 0, shakeY = 0;
    const pitchY = H * 0.72;
    const batsmanX = W * 0.62;
    const bowlerStartX = W * 0.08;
    const bowlerEndX = W * 0.32;

    function getBallPos(frame) {
        if (frame < 40) return null;
        if (frame <= 80) {
            const p = (frame - 40) / 40;
            const ease = p * p;
            const x = bowlerEndX + (batsmanX - 10 - bowlerEndX) * ease;
            const y = pitchY - 30 - Math.sin(p * Math.PI) * 80;
            const scale = 0.5 + p * 0.7;
            return { x, y, scale, hit: false };
        }
        const p = (frame - 82) / 60;
        const x = batsmanX - 10 - p * W * 0.8;
        const y = pitchY - 50 - p * H * 1.2;
        const scale = 1.2 - p * 0.8;
        return { x, y, scale: Math.max(scale, 0.1), hit: true };
    }
    function drawSky() {
        const grad = ctx.createLinearGradient(0, 0, 0, H);
        grad.addColorStop(0, '#0a1628');
        grad.addColorStop(0.4, '#1a2744');
        grad.addColorStop(0.7, '#2d4a2e');
        grad.addColorStop(1, '#1a3a1a');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H);
    }
    function drawStadiumLights() {
        const alpha = Math.min(t / 20, 1);
        for (let i = 0; i < 4; i++) {
            const lx = W * (0.1 + i * 0.27);
            ctx.save();
            ctx.globalAlpha = alpha * 0.15;
            const lg = ctx.createRadialGradient(lx, 0, 0, lx, 0, H * 0.8);
            lg.addColorStop(0, 'rgba(255,255,200,1)');
            lg.addColorStop(1, 'rgba(255,255,200,0)');
            ctx.fillStyle = lg;
            ctx.fillRect(lx - H, -10, H * 2, H);
            ctx.restore();
        }
    }
    function drawGrass() {
        ctx.fillStyle = '#2d5a27';
        ctx.fillRect(0, pitchY - 10, W, H - pitchY + 10);
        ctx.fillStyle = '#c8a96e';
        ctx.fillRect(W * 0.25, pitchY - 8, W * 0.5, 20);
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(batsmanX - 30, pitchY - 8); ctx.lineTo(batsmanX - 30, pitchY + 12); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(batsmanX + 20, pitchY - 8); ctx.lineTo(batsmanX + 20, pitchY + 12); ctx.stroke();
    }
    function drawStumps(x, y) {
        ctx.fillStyle = '#e8d5a3';
        for (let i = -6; i <= 6; i += 6) ctx.fillRect(x + i - 1.5, y - 50, 3, 50);
        ctx.fillStyle = '#d4a843';
        ctx.fillRect(x - 8, y - 52, 7, 3);
        ctx.fillRect(x + 1, y - 52, 7, 3);
    }
    function drawBowler(frame) {
        if (frame > 100) return;
        const runP = Math.min(frame / 40, 1);
        const x = bowlerStartX + (bowlerEndX - bowlerStartX) * runP;
        const bobY = Math.sin(frame * 0.5) * 4;
        const armAngle = frame < 40 ? Math.sin(frame * 0.4) * 0.3 : -Math.PI * 0.5 - (frame - 40) / 10;
        ctx.save();
        ctx.translate(x, pitchY + bobY);
        ctx.fillStyle = '#ffffff'; ctx.fillRect(-8, -55, 16, 30);
        ctx.fillStyle = '#c68642'; ctx.beginPath(); ctx.arc(0, -65, 10, 0, Math.PI * 2); ctx.fill();
        ctx.save(); ctx.translate(6, -50); ctx.rotate(armAngle);
        ctx.fillStyle = '#c68642'; ctx.fillRect(-3, 0, 6, 30);
        if (frame < 40) { ctx.fillStyle = '#cc0000'; ctx.beginPath(); ctx.arc(0, 32, 6, 0, Math.PI * 2); ctx.fill(); }
        ctx.restore();
        ctx.fillStyle = '#fff'; const legSwing = Math.sin(frame * 0.5) * 0.4;
        ctx.save(); ctx.translate(-4, -25); ctx.rotate(legSwing); ctx.fillRect(-3, 0, 6, 28); ctx.restore();
        ctx.save(); ctx.translate(4, -25); ctx.rotate(-legSwing); ctx.fillRect(-3, 0, 6, 28); ctx.restore();
        ctx.restore();
    }
    function drawBatsman(frame) {
        ctx.save(); ctx.translate(batsmanX, pitchY);
        ctx.fillStyle = '#ffffff'; ctx.fillRect(-8, -55, 16, 30);
        ctx.fillStyle = '#c68642'; ctx.beginPath(); ctx.arc(0, -65, 10, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#1a3a8a'; ctx.beginPath(); ctx.arc(0, -68, 11, Math.PI, 0); ctx.fill();
        ctx.fillStyle = '#888'; ctx.fillRect(-10, -62, 20, 3);
        const batAngle = getBatAngle(frame);
        ctx.save(); ctx.translate(10, -45); ctx.rotate(batAngle);
        ctx.fillStyle = '#333'; ctx.fillRect(-2, 0, 4, 20);
        const batGrad = ctx.createLinearGradient(-6, 20, 6, 20);
        batGrad.addColorStop(0, '#e8d5b0'); batGrad.addColorStop(0.5, '#d4b896'); batGrad.addColorStop(1, '#a0845c');
        ctx.fillStyle = batGrad;
        ctx.beginPath(); ctx.moveTo(-6,20); ctx.lineTo(6,20); ctx.lineTo(7,55); ctx.lineTo(-7,55); ctx.closePath(); ctx.fill();
        ctx.fillStyle = '#ff5a00'; ctx.fillRect(-4, 28, 8, 15);
        ctx.restore();
        ctx.fillStyle = '#fff';
        const legBend = frame > 70 && frame < 90 ? -0.2 : 0;
        ctx.save(); ctx.translate(-4, -25); ctx.rotate(legBend); ctx.fillRect(-3,0,6,28); ctx.fillStyle='#f0f0f0'; ctx.fillRect(-4,10,8,18); ctx.restore();
        ctx.save(); ctx.translate(4, -25); ctx.rotate(-legBend*0.5); ctx.fillRect(-3,0,6,28); ctx.fillStyle='#f0f0f0'; ctx.fillRect(-4,10,8,18); ctx.restore();
        ctx.restore();
    }
    function getBatAngle(frame) {
        if (frame < 60) return -0.8;
        if (frame < 70) return -0.8 - ((frame - 60) / 10) * 1.2;
        if (frame < 80) { const p = (frame-70)/10; return -2.0 + p * 3.5; }
        return 1.5;
    }
    function drawBall(frame) {
        const pos = getBallPos(frame);
        if (!pos) return;
        const { x, y, scale } = pos;
        ctx.save(); ctx.translate(x, y); ctx.scale(scale, scale);
        ctx.globalAlpha = 0.3; ctx.fillStyle = '#000';
        ctx.beginPath(); ctx.ellipse(0, 50/scale, 10, 4, 0, 0, Math.PI*2); ctx.fill(); ctx.globalAlpha = 1;
        const bg = ctx.createRadialGradient(-3,-3,1,0,0,12);
        bg.addColorStop(0,'#ff3333'); bg.addColorStop(0.6,'#cc0000'); bg.addColorStop(1,'#880000');
        ctx.fillStyle = bg; ctx.beginPath(); ctx.arc(0,0,12,0,Math.PI*2); ctx.fill();
        ctx.strokeStyle='#fff'; ctx.lineWidth=1.5; ctx.setLineDash([3,2]);
        ctx.beginPath(); ctx.arc(0,0,10,-0.5,Math.PI+0.5); ctx.stroke(); ctx.setLineDash([]);
        ctx.globalAlpha=0.5; ctx.fillStyle='#fff'; ctx.beginPath(); ctx.ellipse(-4,-5,4,2,-0.5,0,Math.PI*2); ctx.fill();
        ctx.restore();
    }
    function spawnImpact() {
        const ix = batsmanX-5, iy = pitchY-50;
        for (let i=0;i<40;i++){const a=Math.random()*Math.PI*2,s=3+Math.random()*12;particles.push({x:ix,y:iy,vx:Math.cos(a)*s,vy:Math.sin(a)*s-5,life:40+Math.random()*30,maxLife:40+Math.random()*30,size:2+Math.random()*4,color:['#ffaa00','#ff5500','#ffff00','#fff'][Math.floor(Math.random()*4)]});}
        for (let i=0;i<20;i++){const a=-Math.PI*0.5+(Math.random()-0.5)*1.5,s=8+Math.random()*15;sparks.push({x:ix,y:iy,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:20+Math.random()*20,maxLife:20+Math.random()*20});}
    }
    function updateParticles() {
        for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.2;p.vx*=0.98;p.life--;if(p.life<=0)particles.splice(i,1);}
        for(let i=sparks.length-1;i>=0;i--){const s=sparks[i];s.x+=s.vx;s.y+=s.vy;s.vy+=0.1;s.life--;if(s.life<=0)sparks.splice(i,1);}
    }
    function drawParticles() {
        particles.forEach(p=>{ctx.globalAlpha=p.life/p.maxLife;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size*(p.life/p.maxLife),0,Math.PI*2);ctx.fill();});
        sparks.forEach(s=>{ctx.globalAlpha=s.life/s.maxLife;ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(s.x,s.y);ctx.lineTo(s.x-s.vx*3,s.y-s.vy*3);ctx.stroke();});
        ctx.globalAlpha=1;
    }
    function drawFlash(frame) {
        if(frame<80||frame>90)return;
        const p=(frame-80)/10;ctx.save();ctx.globalAlpha=1-p;
        const r=50+p*300;const grad=ctx.createRadialGradient(batsmanX-5,pitchY-50,0,batsmanX-5,pitchY-50,r);
        grad.addColorStop(0,'rgba(255,255,255,1)');grad.addColorStop(0.3,'rgba(255,200,0,0.8)');grad.addColorStop(1,'rgba(255,100,0,0)');
        ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);ctx.restore();
    }
    function drawSixText(frame) {
        if(frame<95)return;
        const p=Math.min((frame-95)/25,1);const scale=0.5+p*1.5;const alpha=p<0.8?p/0.8:1-(p-0.8)/0.2;
        ctx.save();ctx.globalAlpha=Math.max(alpha,0);ctx.translate(W/2,H*0.35);ctx.scale(scale,scale);
        ctx.font='italic 900 120px "Outfit",sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
        ctx.shadowColor='#ff5a00';ctx.shadowBlur=60;ctx.fillStyle='#fff';ctx.fillText('SIX!',0,0);
        ctx.shadowBlur=30;ctx.fillText('SIX!',0,0);ctx.shadowBlur=0;
        ctx.strokeStyle='#ff5a00';ctx.lineWidth=3;ctx.strokeText('SIX!',0,0);ctx.restore();
    }
    let impactDone = false;
    function draw() {
        t++;
        if(t>TOTAL){window.location.href=url;return;}
        let sx=0,sy=0;
        if(t>=80&&t<92){const i=8*(1-(t-80)/12);sx=(Math.random()-0.5)*i;sy=(Math.random()-0.5)*i;}
        ctx.save();ctx.translate(sx,sy);
        drawSky();drawStadiumLights();drawGrass();drawStumps(batsmanX+25,pitchY);
        drawBowler(t);drawBatsman(t);drawBall(t);
        if(t===80&&!impactDone){spawnImpact();impactDone=true;}
        updateParticles();drawParticles();drawFlash(t);drawSixText(t);
        if(t>150){ctx.globalAlpha=(t-150)/30;ctx.fillStyle='#fff';ctx.fillRect(-10,-10,W+20,H+20);}
        ctx.restore();
        requestAnimationFrame(draw);
    }
    draw();
}

/* ── Badminton animation (original kept intact) ────────── */
function playBadmintonAnimation(e, url) {
    e.preventDefault();
    const overlay = document.getElementById('badminton-animation-overlay');
    overlay.style.display = 'block';
    const canvas = document.getElementById('badmintonCanvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth*2; canvas.height = window.innerHeight*2;
    ctx.scale(2,2);
    const W=window.innerWidth, H=window.innerHeight;
    let t=0; const TOTAL=170; const feathers=[]; let shakeX=0,shakeY=0;
    const courtY=H*0.72, playerX=W*0.65, netX=W*0.5;

    function getShuttlePos(frame) {
        if(frame<20)return null;
        if(frame<=70){const p=(frame-20)/50;const x=W*0.2+(playerX-W*0.2)*p;const y=courtY-100-Math.sin(p*Math.PI)*H*0.35;return{x,y,scale:0.4+p*0.6,hit:false};}
        if(frame<=72)return null;
        const p=(frame-72)/40;return{x:playerX-p*W*0.7,y:courtY-80+p*60,scale:Math.max(1-p*0.5,0.1),hit:true};
    }
    function drawCourt() {
        const grad=ctx.createLinearGradient(0,0,0,H);
        grad.addColorStop(0,'#1a1a2e');grad.addColorStop(0.5,'#16213e');grad.addColorStop(1,'#0f3460');
        ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);
        const alpha=Math.min(t/15,1);
        for(let i=0;i<5;i++){const lx=W*(0.1+i*0.2);ctx.save();ctx.globalAlpha=alpha*0.12;const lg=ctx.createRadialGradient(lx,0,0,lx,0,H*0.6);lg.addColorStop(0,'#ffffee');lg.addColorStop(1,'transparent');ctx.fillStyle=lg;ctx.fillRect(lx-H,0,H*2,H);ctx.restore();}
        ctx.fillStyle='#2e8b57';ctx.fillRect(W*0.08,courtY-5,W*0.84,H-courtY+5);
        ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.strokeRect(W*0.1,courtY,W*0.8,H*0.22);
        ctx.beginPath();ctx.moveTo(netX,courtY);ctx.lineTo(netX,courtY+H*0.22);ctx.stroke();
        ctx.setLineDash([5,5]);ctx.beginPath();ctx.moveTo(W*0.1,courtY+H*0.08);ctx.lineTo(W*0.9,courtY+H*0.08);ctx.stroke();ctx.setLineDash([]);
    }
    function drawNet() {
        ctx.fillStyle='#aaa';ctx.fillRect(netX-2,courtY-80,4,85);
        ctx.strokeStyle='rgba(255,255,255,0.4)';ctx.lineWidth=1;
        for(let y=courtY-75;y<courtY;y+=8){ctx.beginPath();ctx.moveTo(netX-30,y);ctx.lineTo(netX+30,y);ctx.stroke();}
        for(let x=netX-30;x<=netX+30;x+=6){ctx.beginPath();ctx.moveTo(x,courtY-75);ctx.lineTo(x,courtY);ctx.stroke();}
        ctx.fillStyle='#fff';ctx.fillRect(netX-32,courtY-78,64,4);
    }
    function getRacketAngle(frame){if(frame<55)return -0.5;if(frame<65)return -0.5-((frame-55)/10)*2.0;if(frame<72){const p=(frame-65)/7;return -2.5+p*4.0;}return 1.5;}
    function drawPlayer(frame) {
        ctx.save();ctx.translate(playerX,courtY);
        let jY=0;if(frame>55&&frame<80){const p=(frame-55)/25;jY=-Math.sin(p*Math.PI)*40;}ctx.translate(0,jY);
        ctx.fillStyle='#e63946';ctx.fillRect(-10,-55,20,30);
        ctx.fillStyle='#c68642';ctx.beginPath();ctx.arc(0,-65,10,0,Math.PI*2);ctx.fill();
        ctx.fillStyle='#e63946';ctx.fillRect(-11,-68,22,4);
        const ra=getRacketAngle(frame);
        ctx.save();ctx.translate(10,-48);ctx.rotate(ra);
        ctx.fillStyle='#c68642';ctx.fillRect(-3,0,6,25);
        ctx.fillStyle='#333';ctx.fillRect(-2,25,4,15);
        ctx.save();ctx.translate(0,45);ctx.fillStyle='rgba(200,200,255,0.3)';ctx.strokeStyle='#667';ctx.lineWidth=2;
        ctx.beginPath();ctx.ellipse(0,0,14,18,0,0,Math.PI*2);ctx.fill();ctx.stroke();
        ctx.strokeStyle='rgba(255,255,255,0.3)';ctx.lineWidth=0.5;
        for(let sy=-14;sy<=14;sy+=4){ctx.beginPath();ctx.moveTo(-12,sy);ctx.lineTo(12,sy);ctx.stroke();}
        for(let sx=-10;sx<=10;sx+=4){ctx.beginPath();ctx.moveTo(sx,-16);ctx.lineTo(sx,16);ctx.stroke();}
        ctx.restore();ctx.restore();
        ctx.fillStyle='#c68642';ctx.save();ctx.translate(-8,-48);ctx.rotate(0.3);ctx.fillRect(-3,0,6,22);ctx.restore();
        ctx.fillStyle='#222';const ls=frame>55&&frame<80?0.3:0;
        ctx.save();ctx.translate(-5,-25);ctx.rotate(ls);ctx.fillRect(-3,0,6,28);ctx.restore();
        ctx.save();ctx.translate(5,-25);ctx.rotate(-ls);ctx.fillRect(-3,0,6,28);ctx.restore();
        ctx.fillStyle='#fff';ctx.fillRect(-9,2,8,5);ctx.fillRect(1,2,8,5);
        ctx.restore();
    }
    function drawShuttle(frame) {
        const pos=getShuttlePos(frame);if(!pos)return;
        const{x,y,scale}=pos;ctx.save();ctx.translate(x,y);ctx.scale(scale,scale);ctx.rotate(frame<=70?0.3:-0.8);
        const cg=ctx.createRadialGradient(0,0,1,0,0,8);cg.addColorStop(0,'#fff');cg.addColorStop(1,'#ddd');
        ctx.fillStyle=cg;ctx.beginPath();ctx.arc(0,0,7,0,Math.PI*2);ctx.fill();
        ctx.fillStyle='rgba(255,255,255,0.9)';
        for(let i=-3;i<=3;i++){ctx.save();ctx.rotate(i*0.15);ctx.beginPath();ctx.moveTo(-3,5);ctx.lineTo(3,5);ctx.lineTo(5+Math.abs(i)*2,28);ctx.lineTo(-5-Math.abs(i)*2,28);ctx.closePath();ctx.fill();ctx.restore();}
        ctx.restore();
    }
    function spawnSmash(){const ix=playerX+10,iy=courtY-90;for(let i=0;i<30;i++){const a=Math.random()*Math.PI*2,s=2+Math.random()*10;feathers.push({x:ix,y:iy,vx:Math.cos(a)*s,vy:Math.sin(a)*s-3,life:30+Math.random()*25,maxLife:30+Math.random()*25,size:2+Math.random()*3,color:['#fff','#00d4ff','#66ffcc','#ffff88'][Math.floor(Math.random()*4)]});}}
    function updateFeathers(){for(let i=feathers.length-1;i>=0;i--){const f=feathers[i];f.x+=f.vx;f.y+=f.vy;f.vy+=0.15;f.vx*=0.97;f.life--;if(f.life<=0)feathers.splice(i,1);}}
    function drawFeathers(){feathers.forEach(f=>{ctx.globalAlpha=f.life/f.maxLife;ctx.fillStyle=f.color;ctx.beginPath();ctx.arc(f.x,f.y,f.size*(f.life/f.maxLife),0,Math.PI*2);ctx.fill();});ctx.globalAlpha=1;}
    function drawSmashFlash(frame){if(frame<70||frame>80)return;const p=(frame-70)/10;ctx.save();ctx.globalAlpha=1-p;const r=30+p*250;const grad=ctx.createRadialGradient(playerX+10,courtY-90,0,playerX+10,courtY-90,r);grad.addColorStop(0,'rgba(255,255,255,1)');grad.addColorStop(0.3,'rgba(0,200,255,0.7)');grad.addColorStop(1,'rgba(0,100,255,0)');ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);ctx.restore();}
    function drawSmashText(frame){if(frame<85)return;const p=Math.min((frame-85)/25,1);const scale=0.5+p*1.5;const alpha=p<0.8?p/0.8:1-(p-0.8)/0.2;ctx.save();ctx.globalAlpha=Math.max(alpha,0);ctx.translate(W/2,H*0.35);ctx.scale(scale,scale);ctx.font='italic 900 110px "Outfit",sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.shadowColor='#00d4ff';ctx.shadowBlur=60;ctx.fillStyle='#fff';ctx.fillText('SMASH!',0,0);ctx.shadowBlur=30;ctx.fillText('SMASH!',0,0);ctx.shadowBlur=0;ctx.strokeStyle='#00d4ff';ctx.lineWidth=3;ctx.strokeText('SMASH!',0,0);ctx.restore();}
    let smashDone=false;
    function draw(){
        t++;if(t>TOTAL){window.location.href=url;return;}
        if(t>=70&&t<82){const i=6*(1-(t-70)/12);shakeX=(Math.random()-0.5)*i;shakeY=(Math.random()-0.5)*i;}else{shakeX=0;shakeY=0;}
        ctx.save();ctx.translate(shakeX,shakeY);
        drawCourt();drawNet();drawPlayer(t);drawShuttle(t);
        if(t===70&&!smashDone){spawnSmash();smashDone=true;}
        updateFeathers();drawFeathers();drawSmashFlash(t);drawSmashText(t);
        if(t>140){ctx.globalAlpha=(t-140)/30;ctx.fillStyle='#fff';ctx.fillRect(-10,-10,W+20,H+20);}
        ctx.restore();
        requestAnimationFrame(draw);
    }
    draw();
}
</script>

